# dashboard/.env.example
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
API_PORT=3001
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Radar live news (see docs/superpowers/specs/2026-09-21-radar-web-search-design.md) ---
# Set to true to allow the router to use web search. Default off. Also requires OPENAI_WEB_MODEL (a model whose web_search accepts domain filters; see spec section 11).
WEB_SEARCH_ENABLED=false
# Optional. The router model defaults to OPENAI_MODEL when blank. Efforts: minimal|low|medium|high (not every model accepts every value)
# Recommended (measured in spec section 11, 2026-09-21): OPENAI_ROUTER_MODEL=gpt-4o-mini with OPENAI_ROUTER_EFFORT left blank
# (100% on the 35-case golden set, p95 under 2s). Only gpt-5.4-nano was shown to reject effort 'minimal' (HTTP 400; 'low' works and scored 100%). Leave efforts blank unless the model is known to accept the value.
OPENAI_ROUTER_MODEL=
OPENAI_ROUTER_EFFORT=
# Recommended: OPENAI_WEB_MODEL=gpt-5.4-nano with OPENAI_WEB_EFFORT left blank (fallback: gpt-5.4-mini). The web model must accept the web_search domain filter (not gpt-4o/gpt-4.1).
OPENAI_WEB_MODEL=
OPENAI_WEB_EFFORT=

# Time zone that decides which calendar day the Radar daily briefing belongs to (IANA name; an invalid value falls back to UTC).
BRIEFING_TIMEZONE=Asia/Kolkata
