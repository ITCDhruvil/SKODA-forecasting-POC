# dashboard/.env.example
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
API_PORT=3001
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Radar live news (see docs/superpowers/specs/2026-09-21-radar-web-search-design.md) ---
# Set to true to allow the router to use web search. Default off. Also requires OPENAI_WEB_MODEL (a model whose web_search accepts domain filters; see spec section 11).
WEB_SEARCH_ENABLED=false
# Optional. The router model defaults to OPENAI_MODEL when blank. Efforts: minimal|low|medium|high
# Recommended (measured in spec section 11, 2026-09-21): OPENAI_ROUTER_MODEL=gpt-4o-mini with OPENAI_ROUTER_EFFORT left blank
# (100% on the 35-case golden set, p95 under 2s). Do not set an effort for the gpt-5.4 family: it rejects 'minimal'.
OPENAI_ROUTER_MODEL=
OPENAI_ROUTER_EFFORT=
# Recommended: OPENAI_WEB_MODEL=gpt-5.4-nano with OPENAI_WEB_EFFORT left blank (fallback: gpt-5.4-mini). The web model must accept the web_search domain filter (not gpt-4o/gpt-4.1).
OPENAI_WEB_MODEL=
OPENAI_WEB_EFFORT=
